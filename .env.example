# ---------------------------------------------------------------------------
# D_MAK MUSIC — environment
# Copy to `.env` (never commit `.env`) and restart the server.
# ---------------------------------------------------------------------------

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# REQUIRED to use the CMS at /admin. Generate a strong value, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --------------------------------------------------------------- integrations
# 30-second audio previews proxied from Deezer's public API (no audio stored).
# Set to `off` to disable the player's preview requests entirely.
PREVIEWS=on

# Instagram feed (optional). Requires a Meta app + long-lived token for
# @d_mak_music with instagram_basic + pages_read_engagement. While this is
# empty, the Connect page renders the verified static wall instead of faking
# a live feed.
INSTAGRAM_ACCESS_TOKEN=

# YouTube channel sync (optional). Embeds work without a key.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Newsletter / contact forwarding (optional).
# Any endpoint that accepts a JSON POST — Zapier, Make, n8n, your own function.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Turn request logging off in noisy environments
LOG_REQUESTS=on
